---
const {variant} = Astro.props
---

<a class={'btn ' + variant} href=""><slot/></a>

<style>
    .btn {
        border: 2px solid #021E40;
        padding: 1rem 1.5rem;
        font-family: Bangers, sans-serif;
        text-decoration: none;
        font-size: 1.2rem;
        color: #021E40;
        box-shadow: 8px 8px 0 #021E40;
        background-image: linear-gradient(0deg, #fff 0%, #E9F3FF 100%);
        transition: all 0.1s ease-in-out;        
        position: relative;
        top: 0px;
        left: 0px;
    }

    .btn:hover {
        filter: brightness(1.2);
    }

    .btn:active{
        top: 4px;
        left: 4px;        
        box-shadow: 4px 4px 0 #021E40;
    }

    .btn.primary {
        background: linear-gradient(0deg, #FF9A1D 0%, #fff 100%);
    }

    .btn.cta {
        background: linear-gradient(0deg, #FF9A1D 0%, #fff 100%);
    }
</style>