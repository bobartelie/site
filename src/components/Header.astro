---
import Navlink from "./buttons/Navlink.astro";
import Button from "./buttons/Button.astro";
---

<header>
    <nav>
        <div>
            <img src="images/logo.svg" alt="" srcset="">
            <Button>menu</Button>
        </div>
    </nav>
</header>

<style>
    header {
        position: absolute;
        top: 0;
        width: 100%;
        z-index: 999;
    }
    
    div {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    
    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 2rem;
    }
    
    nav ul {
        display: flex;
        list-style: none;
        gap: 2rem;
        align-items: center;
    }    
    
</style>