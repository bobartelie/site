---
import Container from "../layouts/Container.astro";
import Section from "../layouts/Section.astro";
import Title from "../typography/Title.astro";
---

<Section>
    <Container>
        <img src="images/bob-foto.jpg" alt="" />
        <div>
            <Title>
                Oi eu
                <span>sou o Bob</span>
            </Title>
            <p>
                Lorem ipsum dolor sit amet consectetur adipisicing elit. Fugiat
                ad quisquam voluptate assumenda facilis deserunt omnis minima
                natus odit esse quas minus, quasi ab asperiores possimus. Veniam
                eos odit ad.
            </p>
            <p>
                Siga-me nas redes sociais <a href="">Insta</a>
                <a href="">Behance</a>
            </p>
        </div>
    </Container>
</Section>

<style>
    img {
        width: 100%;
    }

    section {
        background-color: #ffe1bd;
    }

    .container {
        align-items: center;
    }
</style>
