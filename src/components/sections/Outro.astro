---
import Container from "../layouts/Container.astro";
import Section from "../layouts/Section.astro";
---

<Section nextColor="#fff">
    <Container>
        <h2>
            Na BobArtelie, voce transforma talentos em habilidade e habilidade
            em carreira. Aprenda no seu ritmo, com orientaçao clara em um
            ambiente descontraido
        </h2>
    </Container>
</Section>

<style>
    section {
        text-align: center;
        min-height: 30vh;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        background-color: #0a3a74;
    }

    h2 {
        font-size: 2.5rem;
        font-family: Bangers;
        font-weight: lighter;
    }
</style>
